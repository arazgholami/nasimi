{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nasimi",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nasimi",
          "match": "\\b(باشلا|ایشلمه|فونکسییا|عمل|قایتار|وئر|آرالیق|سیرا|اؤزو|و|یا|دییل|اگر|ایسه|یوخسا|عکس|حالدا|گز|دؤور|دوام_ائت|دوامئت|دایان|دئنه|سینا|ایستیسنا|نهایت|ایچری_آل|گتیر|کیلاس|سینیف|دییشن|قوی|سابیت|اولاناقدر|اولدوقجا|ایله|دوام|کئچ|اوبیری|یارات|چاغیر|لغوئت|حامیسی|هربیری|سیل|ایچینده|اؤزونده‌دیر|ایشلت|هرطرفلی|قلوبال|سؤزلوک|دسته|چوخلوق|لیست|ترسینه|سادالا|اوزونلوق|سای|دیر|یاز|اوخو|تیپ|اولاراق|کیمی|دوغرو|دوز|یانلیش|سهف|بوش)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.nasimi",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nasimi",
          "match": "\\\\.?"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.nasimi",
          "match": "\\b((0(x|X)[0-9a-fA-F]*)|(([0-9]+\\.?[0-9]*)|(\\.[0-9]+))((e|E)(\\+|-)?[0-9]+)?)(L|l|UL|ul|u|U|F|f|D|d)?"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.nasimi",
          "match": "#.*$"
        },
        {
          "name": "comment.block.documentation.nasimi",
          "begin": "\"\"\"",
          "end": "\"\"\""
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.nasimi",
          "match": "\\+|\\-|\\*|/|%|\\*\\*|//|=|<|>|<=|>=|==|!=|\\|\\||\\&\\&|~|\\^"
        }
      ]
    }
  },
  "scopeName": "source.nasimi"
}
