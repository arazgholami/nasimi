  "functions": {
    "pythonStyleUpperForLoop": {
      "regex": "^([ \\t]*)(?:gəz|dövr)\\s+([A-Z_\\u00c0-\\u024f][\\w\\u0080-\\uffff]*)\\s+(?:içində|özündədir)\\s+(.+?)\\s*:",
      "replacement": "\\1for \\2 in \\3:"
    },
    "pythonStylePluralForLoop": {
      "regex": "^([ \\t]*)(?:gəz|dövr)\\s+([A-Za-z_\\u0080-\\uffff][\\w\\u0080-\\uffff]*)\\s+(?:içində|özündədir)\\s+([A-Za-z_\\u0080-\\uffff][\\w\\u0080-\\uffff]*(?:lar|lər|ler))\\s*:",
      "replacement": "\\1for \\2 in \\3:"
    },
    "naturalForLoop": {
      "regex": "^([ \\t]*)(?:gəz|dövr)\\s+(.+?)\\s+(?:içində|üzrə)\\s+([A-Za-z_\\u0080-\\uffff][\\w\\u0080-\\uffff]*)\\s*:",
      "replacement": "\\1for \\3 in \\2:"
    },
    "pythonStyleForLoop": {
      "regex": "^([ \\t]*)(?:gəz|dövr)\\s+([A-Za-z_\\u0080-\\uffff][\\w\\u0080-\\uffff]*)\\s+(?:içində|özündədir)\\s+(.+?)\\s*:",
      "replacement": "\\1for \\2 in \\3:"
    },
    "ifWithIse": {
      "regex": "^([ \\t]*)əgər\\s+(.+?)\\s+isə\\s*:",
      "replacement": "\\1if \\2:"
    },
    "elifWithIse": {
      "regex": "^([ \\t]*)yoxsa\\s+əgər\\s+(.+?)\\s+isə\\s*:",
      "replacement": "\\1elif \\2:"
    },
    "elseForm": {
      "regex": "^([ \\t]*)əks(?:\\s+|_)halda\\s*:",
      "replacement": "\\1else:"
    },
    "whileWithOlduqca": {
      "regex": "^([ \\t]*)(.+?)\\s+olduqca\\s*:",
      "replacement": "\\1while \\2:"
    }
  }
}
