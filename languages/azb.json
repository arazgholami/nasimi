  "functions": {
    "pythonStyleUpperForLoop": {
      "regex": "^([ \\t]*)(?:گز|دؤور)\\s+([A-Z_\\u00c0-\\u024f][\\w\\u0080-\\uffff]*)\\s+(?:ایچینده|اؤزونده‌دیر)\\s+(.+?)\\s*:",
      "replacement": "\\1for \\2 in \\3:"
    },
    "pythonStylePluralForLoop": {
      "regex": "^([ \\t]*)(?:گز|دؤور)\\s+([A-Za-z_\\u0080-\\uffff][\\w\\u0080-\\uffff]*)\\s+(?:ایچینده|اؤزونده‌دیر)\\s+([A-Za-z_\\u0080-\\uffff][\\w\\u0080-\\uffff]*(?:lar|lər|ler|لر))\\s*:",
      "replacement": "\\1for \\2 in \\3:"
    },
    "naturalForLoop": {
      "regex": "^([ \\t]*)(?:گز|دؤور)\\s+(.+?)\\s+(?:ایچینده|اوزره)\\s+([A-Za-z_\\u0080-\\uffff][\\w\\u0080-\\uffff]*)\\s*:",
      "replacement": "\\1for \\3 in \\2:"
    },
    "pythonStyleForLoop": {
      "regex": "^([ \\t]*)(?:گز|دؤور)\\s+([A-Za-z_\\u0080-\\uffff][\\w\\u0080-\\uffff]*)\\s+(?:ایچینده|اؤزونده‌دیر)\\s+(.+?)\\s*:",
      "replacement": "\\1for \\2 in \\3:"
    },
    "ifWithIse": {
      "regex": "^([ \\t]*)اگر\\s+(.+?)\\s+ایسه\\s*:",
      "replacement": "\\1if \\2:"
    },
    "elifWithIse": {
      "regex": "^([ \\t]*)یوخسا\\s+اگر\\s+(.+?)\\s+ایسه\\s*:",
      "replacement": "\\1elif \\2:"
    },
    "elseForm": {
      "regex": "^([ \\t]*)عکس(?:\\s+|_)حالدا\\s*:",
      "replacement": "\\1else:"
    },
    "whileWithOlduqca": {
      "regex": "^([ \\t]*)(.+?)\\s+اولدوقجا\\s*:",
      "replacement": "\\1while \\2:"
    }
  }
}
