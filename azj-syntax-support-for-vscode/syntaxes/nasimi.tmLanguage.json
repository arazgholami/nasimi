{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Nasimi",
  "patterns": [
    {
      "include": "#keywords"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.nasimi",
          "match": "\\b(başla|işləmə|funksiya|əməl|qaytar|ver|aralıq|sıra|özü|və|ya|deyil|dəyil|əgər|isə|yoxsa|əks|halda|gəz|dövr|davamet|davam_et|dayan|denə|sına|istisna|nəhayət|içəri_al|gətir|sınıf|sinif|dəyişən|qoy|sabit|qədər|olduqca|ilə|davam|keç|növbəti|yarat|çağır|ləğvet|hamısı|hərbiri|sil|özündədir|içində|işlət|hərtərəfli|qlobal|lügət|dəstə|çoxluq|siyahı|tərsinə|sadala|uzunluq|say|dəyər|yaz|oxu|tip|olaraq|kimi|doğru|düz|yanlış|səhv|boş)\\b"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.nasimi",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.nasimi",
          "match": "\\\\.?"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.nasimi",
          "match": "\\b((0(x|X)[0-9a-fA-F]*)|(([0-9]+\\.?[0-9]*)|(\\.[0-9]+))((e|E)(\\+|-)?[0-9]+)?)(L|l|UL|ul|u|U|F|f|D|d)?"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.nasimi",
          "match": "#.*$"
        },
        {
          "name": "comment.block.documentation.nasimi",
          "begin": "\"\"\"",
          "end": "\"\"\""
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.nasimi",
          "match": "\\+|\\-|\\*|/|%|\\*\\*|//|=|<|>|<=|>=|==|!=|\\|\\||\\&\\&|~|\\^"
        }
      ]
    }
  },
  "scopeName": "source.nasimi"
}
